{
  "name": "kiwiray-messenger",
  "version": "1.0.0",
  "description": "Anonymous messenger with Gmail auth",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"nodemon server/index.js\" \"cd client && npm start\"",
    "build": "cd client && npm run build",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "nodemailer": "^6.9.1",
    "socket.io": "^4.6.1",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.7.0",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "concurrently": "^8.0.0"
  }
}
